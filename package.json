{
  "name": "lp-mindmap",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/build-vendor.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.cjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "build:static": "npm run setup && python3 scripts/setup-gesture-assets.py && npm run verify:assets",
    "dev:cf": "wrangler dev --env staging",
    "deploy:staging": "npm run verify:assets && wrangler deploy --env staging",
    "deploy:production": "npm run verify:assets && wrangler deploy --env production",
    "format": "prettier --write \"**/*.{js,mjs,cjs,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,html,css}\""
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "rxdb": "17.6.0",
    "rxjs": "7.8.2",
    "wrangler": "4.152.0"
  }
}
